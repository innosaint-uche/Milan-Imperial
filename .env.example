# Copy to .env for local development, and set the same values in
# Vercel → Project → Settings → Environment Variables for deploys.
# Never commit the real key.

# Resend API key (Resend dashboard → API Keys). Sending access is enough.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender — REQUIRED. The address must be on a domain verified in Resend
# (Resend → Domains). It does not have to be a real mailbox, and it does not
# have to be the domain the site is hosted on. Replies go to the visitor.
#
# Until a domain is verified, use Resend's shared test sender:
#   CONTACT_FROM_EMAIL="Milan Imperial Website <onboarding@resend.dev>"
# Note: that address only delivers to the Resend account owner's own email.
CONTACT_FROM_EMAIL="Milan Imperial Website <onboarding@resend.dev>"

# Where enquiries are delivered — REQUIRED.
# While using onboarding@resend.dev this MUST be the Resend account's own
# email address; anything else is rejected with a 403. See README.
CONTACT_TO_EMAIL=you@example.com
